<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="650.0" prefWidth="950.0" styleClass="main-window" stylesheets="@../styles/styles.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.kiiwik.pos.controller.ReportesController">
   <top>
      <!-- HEADER / NAVEGACIÓN -->
      <HBox alignment="CENTER_LEFT" prefHeight="55.0" spacing="15.0" styleClass="glass-header" BorderPane.alignment="CENTER">
         <padding><Insets left="20.0" right="20.0" /></padding>
         <children>
            <Label styleClass="header-title" text="KIIWIK POS — Reportes de Ventas">
               <font><Font name="System Bold" size="16.0" /></font>
            </Label>
            <HBox alignment="CENTER_RIGHT" spacing="10.0" HBox.hgrow="ALWAYS">
               <children>
                  <Button onAction="#handleIrPuntoDeVenta" styleClass="btn-nav, btn-pv" text="🛒 Punto de Venta" />
                  <Button onAction="#handleIrInventario" styleClass="btn-nav, btn-inv" text="📦 Inventario" />
                  <Button styleClass="btn-nav, btn-rep" text="📊 Reportes" />
               </children>
            </HBox>
         </children>
      </HBox>
   </top>
   
   <center>
      <VBox spacing="15.0" BorderPane.alignment="CENTER">
         <padding><Insets bottom="20.0" left="20.0" right="20.0" top="20.0" /></padding>
         <children>
            <!-- FILTRO DE FECHAS EN TARJETA -->
            <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="brutalist-card">
               <padding><Insets bottom="12.0" left="15.0" right="15.0" top="12.0" /></padding>
               <children>
                  <Label style="-fx-font-weight: bold;" text="Fecha Inicio:" />
                  <DatePicker fx:id="dpInicio" prefWidth="140.0" />
                  <Label style="-fx-font-weight: bold;" text="Fecha Fin:" />
                  <DatePicker fx:id="dpFin" prefWidth="140.0" />
                  <Button onAction="#handleGenerarReporte" prefHeight="32.0" styleClass="btn-primary" text="📊 Generar Reporte">
                     <HBox.margin>
                        <Insets left="5.0" />
                     </HBox.margin>
                  </Button>
               </children>
            </HBox>

            <!-- TARJETAS DE MÉTRICAS RÁPIDAS (KPIs) -->
            <HBox spacing="15.0">
               <children>
                  <VBox alignment="CENTER_LEFT" styleClass="brutalist-card" HBox.hgrow="ALWAYS">
                     <padding><Insets bottom="12.0" left="15.0" right="15.0" top="12.0" /></padding>
                     <children>
                        <Label style="-fx-font-weight: bold; -fx-font-size: 11px; -fx-text-fill: #666666;" text="TOTAL INGRESOS" />
                        <Label fx:id="lblTotalVendido" style="-fx-font-weight: bold; -fx-font-size: 20px; -fx-text-fill: #7C3AED;" text="0.00 MXN" />
                     </children>
                  </VBox>
                  <VBox alignment="CENTER_LEFT" styleClass="brutalist-card" HBox.hgrow="ALWAYS">
                     <padding><Insets bottom="12.0" left="15.0" right="15.0" top="12.0" /></padding>
                     <children>
                        <Label style="-fx-font-weight: bold; -fx-font-size: 11px; -fx-text-fill: #666666;" text="TOTAL TICKETS" />
                        <Label fx:id="lblCantidadVentas" style="-fx-font-weight: bold; -fx-font-size: 20px;" text="0" />
                     </children>
                  </VBox>
                  <VBox alignment="CENTER_LEFT" styleClass="brutalist-card" HBox.hgrow="ALWAYS">
                     <padding><Insets bottom="12.0" left="15.0" right="15.0" top="12.0" /></padding>
                     <children>
                        <Label style="-fx-font-weight: bold; -fx-font-size: 11px; -fx-text-fill: #666666;" text="TICKET PROMEDIO" />
                        <Label fx:id="lblTicketPromedio" style="-fx-font-weight: bold; -fx-font-size: 20px;" text="0.00 MXN" />
                     </children>
                  </VBox>
               </children>
            </HBox>

            <!-- TABLA DE HISTORIAL CON AJUSTE AUTOMÁTICO DE ANCHO -->
            <TableView fx:id="tblReportes" styleClass="table-view" VBox.vgrow="ALWAYS">
              <columns>
                <TableColumn fx:id="colIdVenta" prefWidth="100.0" text="ID Venta" />
                <TableColumn fx:id="colFecha" prefWidth="180.0" text="Fecha / Hora" />
                <TableColumn fx:id="colMetodoPago" prefWidth="150.0" text="Método Pago" />
                <TableColumn fx:id="colTotal" prefWidth="140.0" text="Total Venta (MXN)" />
              </columns>
               <columnResizePolicy>
                  <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
               </columnResizePolicy>
            </TableView>
         </children>
      </VBox>
   </center>
</BorderPane>