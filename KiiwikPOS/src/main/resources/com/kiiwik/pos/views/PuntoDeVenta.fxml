<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane styleClass="main-window" stylesheets="@../styles/styles.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.kiiwik.pos.controller.PuntoDeVentaController">
   <top>
      <HBox alignment="CENTER_LEFT" prefHeight="50.0" spacing="15.0" style="-fx-background-color: #1A1A1A;" BorderPane.alignment="CENTER">
         <padding><Insets left="15.0" right="15.0" /></padding>
         <children>
            <Label text="KIIWIK POS - Joyería Ambulante" textFill="#F9F6F0">
               <font><Font name="System Bold" size="16.0" /></font>
            </Label>
            <HBox alignment="CENTER_RIGHT" spacing="10.0" HBox.hgrow="ALWAYS">
               <children>
                  <Button styleClass="btn-primary" text="Punto de Venta" />
                  <Button onAction="#handleIrInventario" styleClass="btn-secondary" text="📦 Inventario" />
                  <Button onAction="#handleIrReportes" styleClass="btn-secondary" text="📊 Reportes" />
               </children>
            </HBox>
         </children>
      </HBox>
   </top>
   <center>
      <HBox spacing="15.0" BorderPane.alignment="CENTER">
         <padding><Insets bottom="15.0" left="15.0" right="15.0" top="15.0" /></padding>
         <children>
            <!-- CATÁLOGO DE PRODUCTOS -->
            <VBox spacing="10.0" styleClass="brutalist-card" HBox.hgrow="ALWAYS">
               <padding><Insets bottom="10.0" left="10.0" right="10.0" top="10.0" /></padding>
               <children>
                  <HBox alignment="CENTER_LEFT" spacing="10.0">
                     <children>
                        <Label text="Categoría (RF03):">
                           <font><Font name="System Bold" size="12.0" /></font>
                        </Label>
                        <ComboBox fx:id="cmbCategoria" prefWidth="120.0" style="-fx-border-color: #1A1A1A;" />
                        <Label text="Material:">
                           <font><Font name="System Bold" size="12.0" /></font>
                        </Label>
                        <ComboBox fx:id="cmbMaterial" prefWidth="120.0" style="-fx-border-color: #1A1A1A;" />
                     </children>
                  </HBox>
               </children>
            </VBox>

            <!-- CARRITO DE COMPRAS -->
            <VBox prefWidth="380.0" spacing="10.0" styleClass="brutalist-card">
               <padding><Insets bottom="10.0" left="10.0" right="10.0" top="10.0" /></padding>
               <children>
                  <Label text="CARRITO DE COMPRAS">
                     <font><Font name="System Bold" size="14.0" /></font>
                  </Label>
                  <TableView fx:id="tblCarrito" prefHeight="250.0" VBox.vgrow="ALWAYS">
                    <columns>
                      <TableColumn fx:id="colProducto" prefWidth="140.0" text="Producto" />
                      <TableColumn fx:id="colCantidad" prefWidth="50.0" text="Cant." />
                      <TableColumn fx:id="colPrecio" prefWidth="80.0" text="Precio" />
                      <TableColumn fx:id="colSubtotal" prefWidth="80.0" text="Subtotal" />
                    </columns>
                  </TableView>
                  <VBox spacing="8.0" style="-fx-background-color: #F4F1EA; -fx-padding: 10; -fx-border-color: #1A1A1A; -fx-border-width: 2;">
                     <children>
                        <HBox alignment="CENTER_LEFT">
                           <children>
                              <Label text="TOTAL A PAGAR:">
                                 <font><Font name="System Bold" size="14.0" /></font>
                              </Label>
                              <HBox alignment="CENTER_RIGHT" HBox.hgrow="ALWAYS">
                                 <children>
                                    <Label fx:id="lblTotal" text="0.00 MXN">
                                       <font><Font name="System Bold" size="16.0" /></font>
                                    </Label>
                                 </children>
                              </HBox>
                           </children>
                        </HBox>
                        <Label text="Método de Pago (RF04):">
                           <font><Font size="11.0" /></font>
                        </Label>
                        <HBox spacing="15.0">
                           <children>
                              <RadioButton fx:id="rbEfectivo" selected="true" text="Efectivo" />
                              <RadioButton fx:id="rbTransferencia" text="Transferencia" />
                           </children>
                        </HBox>
                        <HBox spacing="10.0">
                           <children>
                              <Button fx:id="btnLimpiar" onAction="#handleLimpiarCarrito" styleClass="btn-secondary" text="Limpiar" />
                              <Button fx:id="btnCobrar" onAction="#handleAbrirModalCobro" styleClass="btn-primary" text="✔ CONFIRMAR COBRO" HBox.hgrow="ALWAYS" />
                           </children>
                        </HBox>
                     </children>
                  </VBox>
               </children>
            </VBox>
         </children>
      </HBox>
   </center>
</BorderPane>