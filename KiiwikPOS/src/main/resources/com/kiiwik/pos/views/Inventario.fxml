<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane styleClass="main-window" stylesheets="@../styles/styles.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.kiiwik.pos.controller.InventarioController">
   <top>
      <HBox alignment="CENTER_LEFT" prefHeight="50.0" spacing="15.0" style="-fx-background-color: #1A1A1A;" BorderPane.alignment="CENTER">
         <padding><Insets left="15.0" right="15.0" /></padding>
         <children>
            <Label text="KIIWIK POS - Gestión de Inventario" textFill="#F9F6F0">
               <font><Font name="System Bold" size="16.0" /></font>
            </Label>
            <HBox alignment="CENTER_RIGHT" spacing="10.0" HBox.hgrow="ALWAYS">
               <children>
                  <Button onAction="#handleIrPuntoDeVenta" styleClass="btn-secondary" text="🛒 Punto de Venta" />
                  <Button styleClass="btn-primary" text="📦 Inventario" />
               </children>
            </HBox>
         </children>
      </HBox>
   </top>
   <center>
      <VBox spacing="15.0" BorderPane.alignment="CENTER">
         <padding><Insets bottom="15.0" left="15.0" right="15.0" top="15.0" /></padding>
         <children>
            <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="brutalist-card">
               <padding><Insets bottom="10.0" left="10.0" right="10.0" top="10.0" /></padding>
               <children>
                  <TextField fx:id="txtBuscar" prefWidth="250.0" promptText="🔍 Buscar por nombre o ID..." style="-fx-border-color: #1A1A1A;" />
                  <ComboBox fx:id="cmbMaterial" prefWidth="150.0" promptText="Material" style="-fx-border-color: #1A1A1A;" />
                  <HBox alignment="CENTER_RIGHT" spacing="10.0" HBox.hgrow="ALWAYS">
                     <children>
                        <Button onAction="#handleNuevoProducto" styleClass="btn-primary" text="+ Nuevo Producto" />
                        <Button onAction="#handleEditarProducto" styleClass="btn-secondary" text="✏️ Editar" />
                        <Button onAction="#handleEliminarProducto" styleClass="btn-danger" text="🗑️ Eliminar" />
                     </children>
                  </HBox>
               </children>
            </HBox>

            <TableView fx:id="tblInventario" style="-fx-border-color: #1A1A1A; -fx-border-width: 2;" VBox.vgrow="ALWAYS">
              <columns>
                <TableColumn fx:id="colCodigo" prefWidth="80.0" text="ID" />
                <TableColumn fx:id="colNombre" prefWidth="220.0" text="Producto" />
                <TableColumn fx:id="colCategoria" prefWidth="130.0" text="Categoría" />
                <TableColumn fx:id="colMaterial" prefWidth="130.0" text="Material" />
                <TableColumn fx:id="colPrecio" prefWidth="100.0" text="Precio (MXN)" />
                <TableColumn fx:id="colStock" prefWidth="90.0" text="Stock" />
              </columns>
            </TableView>
         </children>
      </VBox>
   </center>
</BorderPane>