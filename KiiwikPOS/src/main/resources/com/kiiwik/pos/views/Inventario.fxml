<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="650.0" prefWidth="950.0" styleClass="main-window" stylesheets="@../styles/styles.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.kiiwik.pos.controller.InventarioController">
   <top>
      <!-- HEADER / NAVEGACIÓN -->
      <HBox alignment="CENTER_LEFT" prefHeight="55.0" spacing="15.0" styleClass="glass-header" BorderPane.alignment="CENTER">
         <padding><Insets left="20.0" right="20.0" /></padding>
         <children>
            <Label styleClass="header-title" text="KIIWIK POS — Gestión de Inventario">
               <font><Font name="System Bold" size="16.0" /></font>
            </Label>
            <HBox alignment="CENTER_RIGHT" spacing="10.0" HBox.hgrow="ALWAYS">
               <children>
                  <Button onAction="#handleIrPuntoDeVenta" styleClass="btn-nav, btn-pv" text="🛒 Punto de Venta" />
                  <Button styleClass="btn-nav, btn-inv" text="📦 Inventario" />
                  <Button onAction="#handleIrReportes" styleClass="btn-nav, btn-rep" text="📊 Reportes" />
               </children>
            </HBox>
         </children>
      </HBox>
   </top>
   
   <center>
      <VBox spacing="15.0" BorderPane.alignment="CENTER">
         <padding><Insets bottom="20.0" left="20.0" right="20.0" top="20.0" /></padding>
         <children>
            <!-- BARRA DE ACCIONES Y BÚSQUEDA -->
            <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="brutalist-card">
               <padding><Insets bottom="12.0" left="15.0" right="15.0" top="12.0" /></padding>
               <children>
                  <TextField fx:id="txtBuscar" prefWidth="260.0" promptText="🔍 Buscar por nombre o ID..." />
                  <ComboBox fx:id="cmbMaterial" prefWidth="160.0" promptText="Material" />
                  <HBox alignment="CENTER_RIGHT" spacing="10.0" HBox.hgrow="ALWAYS">
                     <children>
                        <Button onAction="#handleNuevoProducto" prefHeight="32.0" styleClass="btn-primary" text="+ Nuevo Producto" />
                        <Button onAction="#handleEditarProducto" prefHeight="32.0" styleClass="btn-secondary" text="✏️ Editar" />
                        <Button onAction="#handleEliminarProducto" prefHeight="32.0" styleClass="btn-danger" text="🗑️ Eliminar" />
                     </children>
                  </HBox>
               </children>
            </HBox>

            <!-- TABLA DE INVENTARIO -->
            <TableView fx:id="tblInventario" styleClass="table-view" VBox.vgrow="ALWAYS">
              <columns>
                <TableColumn fx:id="colCodigo" prefWidth="70.0" text="ID" />
                <TableColumn fx:id="colNombre" prefWidth="220.0" text="Producto" />
                <TableColumn fx:id="colCategoria" prefWidth="130.0" text="Categoría" />
                <TableColumn fx:id="colMaterial" prefWidth="130.0" text="Material" />
                <TableColumn fx:id="colPrecio" prefWidth="110.0" text="Precio (MXN)" />
                <TableColumn fx:id="colStock" prefWidth="80.0" text="Stock" />
              </columns>
               <columnResizePolicy>
                  <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
               </columnResizePolicy>
            </TableView>
         </children>
      </VBox>
   </center>
</BorderPane>